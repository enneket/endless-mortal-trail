{
  "id": "08_night_city",
  "title": "夜城",
  "atmosphere": { "time": "深夜", "weather": "星空璀璨", "mood": "静谧" },
  "texts": [
    { "content": "夜深了，城市安静下来。", "delay": 0 },
    { "content": "街道上只剩下零星的灯笼，和偶尔经过的巡夜人。", "delay": 2000 },
    { "content": "你独自走在街上，听着自己的脚步声。", "delay": 2000 },
    { "content": "星星很亮，风很轻。你能听到远处传来的虫鸣声。", "delay": 2000 },
    { "content": "{{NPC_SLOT_8:greeting}}", "delay": 1500 },
    { "content": "是{{NPC_SLOT_8:name}}。{{NPC_SLOT_8:identity}}。", "delay": 1000 },
    { "content": "{{NPC_SLOT_8:reveal}}", "delay": 2000 },
    { "content": "你得到了{{ITEM_SLOT_D:name}}。", "delay": 1500 },
    { "content": "{{ITEM_SLOT_D:description}}", "delay": 1000 },
    { "content": "夜风拂过脸颊，带着花草的清香。和平的夜晚，原来是这样的。", "delay": 2000 }
  ],
  "choices": [
    {
      "text": "\"是时候看清这一切了。\"",
      "target": "09_truth_revealed",
      "effects": { "wisdom": 2 },
      "condition": null
    },
    {
      "text": "\"再走走，再想想。\"",
