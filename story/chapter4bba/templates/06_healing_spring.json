    { "content": "泉水边，有人在疗伤。", "delay": 1500 },
    { "content": "{{NPC_SLOT_6:greeting}}", "delay": 1500 },
    { "content": "是{{NPC_SLOT_6:name}}。{{NPC_SLOT_6:identity}}。", "delay": 1000 },
    { "content": "{{NPC_SLOT_6:name}}递给你一样东西。{{ITEM_SLOT_C:description}}", "delay": 2000 },
    { "content": "\"把伤痛留在泉水里。\"{{NPC_SLOT_6:name}}说，\"它会帮你带走的。\"", "delay": 2000 }
