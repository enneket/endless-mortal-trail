    { "content": "四周静得出奇，连鸟叫声都听不到。只有你自己的呼吸声。", "delay": 2000 },
    { "content": "{{NPC_SLOT_2:greeting}}", "delay": 1500 },
    { "content": "是{{NPC_SLOT_2:name}}。{{NPC_SLOT_2:identity}}。", "delay": 1000 },
    { "content": "你在林中发现了{{ITEM_SLOT_A:name}}——{{ITEM_SLOT_A:description}}。", "delay": 2000 },
    { "content": "{{NPC_SLOT_2:reveal}}", "delay": 2000 }
  ],
