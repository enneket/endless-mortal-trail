      "effects": { "wisdom": 1 },
      "condition": null
    },
    {
      "text": "“这林子看起来不太对劲，我还是绕路吧。”",
      "target": "04_hidden_spring",
      "effects": { "mood": "谨慎" },
      "condition": null
    }
  ],
